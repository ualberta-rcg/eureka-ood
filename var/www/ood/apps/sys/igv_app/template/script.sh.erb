#!/usr/bin/env bash

echo "[script.sh.erb] Starting IGV session for user: $USER"
echo "[script.sh.erb] Working directory: $HOME"
cd "${HOME}" || {
  echo "[script.sh.erb] ERROR: Failed to change to home directory: $HOME"
  exit 1
}

# Run any user-specified "Additional environment setup" commands first.
<% if context.respond_to?(:additional_environment) && context.additional_environment.present? %>
echo "[script.sh.erb] Applying additional environment setup..."
JOB_DIR="${JOB_DIR:-$(pwd)}"
cat > "${JOB_DIR}/additional_env.sh" << 'EOF'
<%= context.additional_environment %>
EOF
source "${JOB_DIR}/additional_env.sh"
<% end %>

# If a GPU was requested for this IGV session, load CUDA toolkit in case GPU-accelerated tools are used alongside IGV.
<% if defined?(gpu_checkbox) && gpu_checkbox == "1" && defined?(gpu_type) && gpu_type && gpu_type != "none" %>
echo "[script.sh.erb] GPU selected in form (type=<%= gpu_type %>); loading CUDA toolkit module cuda/12.9."
module load cuda/12.9
<% end %>

echo "[script.sh.erb] Loading IGV modules..."
module purge

# IGV 2.9.2 requires StdEnv/2020 as a prerequisite
TARGET_ENV_MODULE="StdEnv/2020"
# Allow users/admins to override the exact IGV module via IGV_MODULE (defaults to igv/2.9.2)
TARGET_IGV_MODULE="${IGV_MODULE:-igv/2.9.2}"

if module load "${TARGET_ENV_MODULE}" "${TARGET_IGV_MODULE}"; then
  echo "[script.sh.erb] Successfully loaded ${TARGET_ENV_MODULE} and ${TARGET_IGV_MODULE}"
else
  echo "[script.sh.erb] ERROR: Failed to load required modules: ${TARGET_ENV_MODULE} ${TARGET_IGV_MODULE}"
  echo "[script.sh.erb] Hint: set IGV_MODULE in Additional environment setup if your module name differs."
  exit 1
fi

# Resolve IGV launch script; prefer igv.sh, fall back to igv
IGV_BIN=""
if command -v igv.sh >/dev/null 2>&1; then
  IGV_BIN="$(command -v igv.sh)"
elif command -v igv >/dev/null 2>&1; then
  IGV_BIN="$(command -v igv)"
fi

if [[ -z "${IGV_BIN}" ]]; then
  echo "[script.sh.erb] ERROR: Neither 'igv.sh' nor 'igv' was found in PATH after module load."
  exit 1
fi

echo "[script.sh.erb] Using IGV launcher: ${IGV_BIN}"

echo "[script.sh.erb] Launching IGV..."
exec "${IGV_BIN}"

echo "[script.sh.erb] IGV session ended."

